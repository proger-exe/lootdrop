APP_NAME=LootDrop
ENVIRONMENT=development
LOG_LEVEL=INFO

BOT_TOKEN=
BOT_USERNAME=
BOT_OWNER_IDS=
BOT_ADMIN_IDS=
BOT_MAIN_BANNER_PATH=

TELEGRAM_POLLING_TIMEOUT_SECONDS=30

SQLITE_PATH=./data/lootdrop.sqlite3
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_FOREIGN_KEYS=true

MEMORY_LOCK_TTL_SECONDS=30
MEMORY_RATE_LIMIT_TTL_SECONDS=3600

CRYPTAPI_BASE_URL=https://api.cryptapi.io
CRYPTAPI_CALLBACK_BASE_URL=
CRYPTAPI_REQUEST_TIMEOUT=15
CRYPTAPI_DEFAULT_CONFIRMATIONS=1
CRYPTAPI_PUBLIC_KEY_CACHE_TTL=86400

STORE_BASE_CURRENCY=RUB
PAYMENTS_PROVIDER=mock
PAYMENT_INVOICE_TTL_MINUTES=30
PAYMENT_CHECK_COOLDOWN_SECONDS=20
PAYMENT_POLL_INTERVAL_SECONDS=20
PAYMENT_POLL_BATCH_SIZE=50
PAYMENT_TOLERANCE_COIN=0.00000001

FULFILLMENT_ENCRYPTION_KEY=

RAITO_DEVTOOLS_ENABLED=false
RAITO_HOT_RELOAD_ENABLED=false
RAITO_REPL_ENABLED=false

SENTRY_DSN=
